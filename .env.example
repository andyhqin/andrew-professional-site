# Copy to .env.local for development. On Netlify, set these in the site's
# environment variables. Never commit real values.

# The site's public address, used for canonical URLs, the sitemap, and share
# previews. Without a domain, use the Netlify subdomain you choose.
SITE_URL=https://andrew-qin.netlify.app

# Where contact form messages are sent.
CONTACT_NOTIFY_TO=you@example.com

# Resend sends the contact form's email. Without your own domain, sign up to
# Resend with the CONTACT_NOTIFY_TO address and keep the default sender below:
# Resend's shared address can only email the account's own address.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Set to true on a staging copy of the site, to keep it out of search results.
# BLOCK_INDEXING=true

# Not used by the site itself: installs read it, via .npmrc, to fetch the
# private @andyhqin packages. A classic token with only read:packages.
# PACKAGES_TOKEN=
